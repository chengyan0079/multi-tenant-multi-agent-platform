# ===== 服务 =====
APP_NAME=agent-platform
APP_ENV=dev

# ===== PostgreSQL（checkpointer + 业务 + 记忆）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_platform

# ===== Redis（会话/缓存/队列/HITL）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Milvus（向量，BGE-M3）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_DB_NAME=agent_platform
MILVUS_COLLECTION=agent_memory
MILVUS_DENSE_DIM=1024
MILVUS_DENSE_WEIGHT=0.8
MILVUS_SPARSE_WEIGHT=0.2
MILVUS_RRF_K=60

# ===== 模型网关（OpenAI 兼容）=====
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
CLASSIFIER_DIR=

# ===== rag-ultra 适配层（复用，不重建）=====
RAG_ULTRA_IMPORT_PATH=E:/cywork/python/project/RAG-Ultra
RAG_ULTRA_HTTP_BASE=

# ===== 安全（本项目不做登录：身份由上游网关断言，后端只验签+查库授权）=====
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
TENANT_HEADER=X-Tenant-Id
USER_HEADER=X-User-Id
TRUST_HEADERS=False
DEV_USER_ID=dev-user
DEV_TENANT_ID=dev-tenant

# ===== 可观测 =====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 服务身份（Nacos 注册）=====
SERVICE_NAME=agent-platform
SERVICE_IP=127.0.0.1
PORT=8000
VERSION=0.1.0

# ===== Nacos 服务发现（仅注册发现，单独命名空间）=====
NACOS_ENABLED=True
NACOS_SERVER_ADDR=http://localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_DISCOVER_STRICT=False

# ===== Nacos 配置中心（独立命名空间，与发现分离）=====
NACOS_CONFIG_ENABLED=True
NACOS_CONFIG_SERVER_ADDR=http://localhost:8848
NACOS_CONFIG_NAMESPACE=agent-platform
NACOS_CONFIG_GROUP=SYSTEM
NACOS_CONFIG_USER=
NACOS_CONFIG_PASSWORD=

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_SIZE=1073741824
LOG_FILE_DAYS=7

# ===== API 调用日志（中间件记录请求+响应并落库）=====
API_LOG_ENABLED=True
API_LOG_DB=True
API_LOG_MAX_BODY=8192
API_LOG_EXCLUDE=/docs,/redoc,/openapi.json,/admin/health
