# ===== 服务 =====
APP_NAME=agent-platform
APP_ENV=dev

# ===== PostgreSQL（checkpointer + 业务 + 记忆）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_platform

# ===== Redis（会话/缓存/队列/HITL）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Milvus（向量，BGE-M3）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_DB_NAME=agent_platform
MILVUS_COLLECTION=agent_memory
MILVUS_DENSE_DIM=1024
MILVUS_DENSE_WEIGHT=0.8
MILVUS_SPARSE_WEIGHT=0.2
MILVUS_RRF_K=60

# ===== 离线模块（offline/：意图识别训练/评估，与在线解耦；详见 offline/__init__.py）=====
OFFLINE_DATA=offline/sample_data/intents.jsonl
OFFLINE_BASE_MODEL=bert-base-chinese
OFFLINE_MODEL_OUT=models/bert-intent-recognition-model
OFFLINE_EPOCHS=3
OFFLINE_BATCH=16
OFFLINE_LR=0.00002
OFFLINE_MAX_LEN=64

# ===== RAG 检索适配层（自研，参考 rag-ultra）=====
RAG_IMPORT_PATH=
RAG_HTTP_BASE=

# ===== MinIO（S3 兼容对象存储：文档/媒体/轨迹产物）=====
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=agent-platform
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== 文件上传限制 =====
# 单文件大小上限（MB）
FILE_MAX_UPLOAD_MB=200

# ===== 安全（token 单源：身份只来自 Authorization: Bearer <JWT>，不读身份头/开发兜底）=====
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 登录会话在 Redis 的 TTL（秒）：15 分钟无操作即失效，每次请求滑动续期
SESSION_TTL_SECONDS=900

# ===== 可观测 =====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== 服务身份（Nacos 注册 / API 文档）=====
SERVICE_NAME=agent-platform
SERVICE_IP=127.0.0.1
PORT=8000
VERSION=0.1.0
# True=暴露 /docs（Swagger UI）、/redoc、/openapi.json；生产建议 False
DOCS_ENABLED=False

# ===== Nacos 服务发现（仅注册发现，单独命名空间）=====
NACOS_ENABLED=True
NACOS_SERVER_ADDR=http://localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_DISCOVER_STRICT=True

# ===== Nacos 配置中心（独立命名空间，与发现分离）=====
NACOS_CONFIG_ENABLED=True
NACOS_CONFIG_SERVER_ADDR=http://localhost:8848
NACOS_CONFIG_NAMESPACE=agent-platform
NACOS_CONFIG_GROUP=SYSTEM
NACOS_CONFIG_USER=
NACOS_CONFIG_PASSWORD=

# ===== 日志 =====
LOG_LEVEL=INFO
# 相对路径以项目根目录为基准（与启动时的工作目录无关），即 <项目根>/logs/app.log
LOG_FILE=logs/app.log
LOG_SIZE=1073741824
LOG_FILE_DAYS=7

# ===== API 调用日志（中间件记录请求元数据并落库）=====
API_LOG_ENABLED=True
API_LOG_DB=True
# 默认只记元数据（方法/路径/状态/耗时/身份），不存请求体与响应体
API_LOG_SAVE_BODY=False
# 仅 SAVE_BODY=True 时生效，超出截断
API_LOG_MAX_BODY=8192
API_LOG_EXCLUDE_RAW=/docs,/redoc,/openapi.json,/api/v1/health,/api/v1/admin/audit/api-logs
