<?xml version="1.0"?>
<clickhouse>
    <!-- 单节点 ClickHouse Keeper（嵌入版 Zookeeper），供 ReplicatedMergeTree / ON CLUSTER 使用 -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/log/clickhouse-server/keeper</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>information</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>clickhouse</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- 客户端（含 Langfuse 迁移脚本）通过 Keeper 端口 9181 寻址 -->
    <zookeeper>
        <node>
            <host>clickhouse</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Langfuse v4 迁移用 ON CLUSTER default，这里定义单分片单副本的 default 集群 -->
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!-- ReplicatedMergeTree 建表需要 macros 表明本节点 shard/replica -->
    <macros>
        <shard>1</shard>
        <replica>clickhouse</replica>
    </macros>
</clickhouse>
