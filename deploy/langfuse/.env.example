# =====================================================================
# Langfuse 自托管环境变量示例
# 复制为 .env 后，把右侧占位符替换为你的真实值。
# 重点：下方 PG / Redis / MinIO 三项的 *_HOST / ENDPOINT 必须能被
# langfuse 容器访问（与你现有基建在同一 Docker 网络，或填
# host.docker.internal / 宿主局域网 IP）。
# =====================================================================

# ---------- Langfuse 自身密钥（必改）----------
NEXTAUTH_URL=http://localhost:3000
# 生成： openssl rand -hex 32
NEXTAUTH_SECRET=REPLACE_WITH_32_BYTE_HEX
# 生成： openssl rand -hex 16
SALT=REPLACE_WITH_16_BYTE_HEX
# 生成： openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# ---------- PostgreSQL（复用现有，需先建库：CREATE DATABASE langfuse;）----------
# 格式： postgresql://<user>:<password>@<host>:<port>/langfuse
DATABASE_URL=postgresql://langfuse:YOUR_PG_PASSWORD@pg-host:5432/langfuse

# ---------- ClickHouse（本栈新增，密码自定义）----------
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=YOUR_CLICKHOUSE_PASSWORD
CLICKHOUSE_DB=default

# ---------- Redis（复用现有）----------
# 若 Redis 无密码，REDIS_AUTH 留空
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_AUTH=YOUR_REDIS_PASSWORD

# ---------- MinIO / S3（复用现有，需先建桶：langfuse）----------
S3_BUCKET=langfuse
S3_REGION=auto
S3_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
S3_SECRET_KEY=YOUR_MINIO_SECRET_KEY
# 必须能被 langfuse 容器访问；MinIO 用 IP:9000，不要填 :9090 控制台端口
S3_ENDPOINT=http://minio-host:9000
